# .env 설명서

# 단짝친구 로컬 개발용 환경변수 견본
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다
#   cd infra
#   Copy-Item .env.example .env
# .env 는 .gitignore 로 제외되므로 커밋되지 않는다.

# MySQL 관리자(root) 비밀번호. 각자 정한다. 로컬 전용
MYSQL_ROOT_PASSWORD=change_me

# 애플리케이션이 사용할 DB와 계정
# 아래 세 값은 backend/src/main/resources/application.properties 의
# 기본값과 일치해야 백엔드가 추가 설정 없이 접속된다. 변경 금지
MYSQL_DATABASE=danjjak
MYSQL_USER=danjjak
MYSQL_PASSWORD=danjjak_local

# 호스트에 공개할 포트. 3306 이 이미 쓰이면 13306 등으로 변경
# 변경 시 백엔드의 DANJJAK_DB_URL 도 같은 포트로 맞춰야 한다
MYSQL_PORT=3306
